# Copy to .env and fill in. Never commit .env.
# Ollama (local):  LLM_BASE_URL=http://localhost:11434/v1
#                   LLM_API_KEY=ollama
#                   LLM_MODEL=gemma3:1b
# OpenRouter (hosted): LLM_BASE_URL=https://openrouter.ai/api/v1
#                   LLM_API_KEY=<your key>
#                   LLM_MODEL=openrouter/free
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Set to 1 to skip the model and return a schema-valid stub.
LLM_STUB=
# Set to false to disable the model call entirely and return the fallback.
LLM_ENABLED=