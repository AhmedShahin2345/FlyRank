{
  "name": "Brief Scout Agent (FL-07 + W6 Scheduler & Slack)",
  "nodes": [
    {
      "id": "wh-1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "brief-agent",
      "parameters": {
        "path": "brief-agent",
        "httpMethod": "POST",
        "responseMode": "responseNode"
      }
    },
    {
      "id": "cron-1",
      "name": "Schedule Trigger (Every Tue 09:00)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        -180
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "weeksInterval": 1,
              "triggerAtDay": [
                2
              ],
              "triggerAtHour": 9,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "id": "set-1",
      "name": "Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "url",
              "value": "={{ $json.body?.url || $json.url || 'https://www.retaildive.com/feeds/news/' }}",
              "type": "string"
            },
            {
              "id": "2",
              "name": "topic",
              "value": "={{ $json.body?.topic || $json.topic || 'retail' }}",
              "type": "string"
            },
            {
              "id": "3",
              "name": "max_items",
              "value": "={{ $json.body?.max_items || $json.max_items || 3 }}",
              "type": "number"
            }
          ]
        }
      }
    },
    {
      "id": "rss-1",
      "name": "Gather \u00b7 RSS Feed",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.2,
      "position": [
        460,
        0
      ],
      "parameters": {
        "url": "={{ $json.url }}"
      }
    },
    {
      "id": "lim-1",
      "name": "Limit",
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [
        620,
        0
      ],
      "parameters": {
        "maxItems": "={{ $('Input').first().json.max_items }}"
      }
    },
    {
      "id": "ollama-1",
      "name": "Synthesize \u00b7 Ollama (gemma3:1b)",
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "typeVersion": 1,
      "position": [
        780,
        160
      ],
      "parameters": {
        "model": "gemma3:1b",
        "baseUrl": "http://127.0.0.1:11434"
      },
      "credentials": {
        "ollamaApi": {
          "id": "1nNdK2Q5uooDKj93",
          "name": "Ollama Local"
        }
      }
    },
    {
      "id": "llm-1",
      "name": "Synthesize \u00b7 LLM Chain",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        780,
        0
      ],
      "parameters": {
        "promptType": "define",
        "text": "You write a weekly industry brief on the topic \"{{ $('Input').first().json.topic }}\". The article below is one item from the feed. Respond with exactly three lines:\nINSIGHT: one sentence, what the reader should remember\nTAG: one of [gen-z, retail, social, data, campaigns, platform]\nRELEVANCE: one sentence, why a youth-marketing operator should care\n\nArticle:\nTitle: {{ $json.title }}\nLink: {{ $json.link }}\nDescription: {{ $json.contentSnippet }}",
        "options": {
          "systemMessage": "You write crisp industry briefs for a youth-marketing operator. Never invent facts, never ask for input, never add preamble. Output only the three labelled lines. Keep every line under 25 words."
        }
      }
    },
    {
      "id": "fmt-1",
      "name": "Format \u00b7 Brief",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1020,
        0
      ],
      "parameters": {
        "jsCode": "const items = $('Limit').all();\nconst briefs = $('Synthesize \u00b7 LLM Chain').all();\nconst topic = $('Input').first().json.topic ?? 'retail';\nconst out = [];\nconst n = Math.min(items.length, briefs.length);\nlet markdown = '# Weekly Brief \u2014 ' + topic + ' \u2014 ' + new Date().toISOString().slice(0, 10) + '\\n\\n';\n\nfor (let i = 0; i < n; i++) {\n  const title = items[i].json.title ?? 'untitled';\n  const link = items[i].json.link ?? '';\n  const ai = briefs[i].json.text ?? '';\n  out.push({ title, link, ai });\n  markdown += '### ' + (i+1) + '. ' + title + '\\n' + '**Link:** ' + link + '\\n\\n' + ai + '\\n\\n---\\n\\n';\n}\n\nreturn [{ json: { topic, generated_at: new Date().toISOString(), count: out.length, briefs: out, text: markdown } }];"
      }
    },
    {
      "id": "slack-1",
      "name": "Post to Slack Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1240,
        -100
      ],
      "continueOnFail": true,
      "parameters": {
        "method": "POST",
        "url": "https://httpbin.org/anything/slack-brief",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "text",
              "value": "={{ $json.text }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "respond-1",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1240,
        100
      ],
      "parameters": {
        "respondWith": "allIncomingItems",
        "options": {}
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
