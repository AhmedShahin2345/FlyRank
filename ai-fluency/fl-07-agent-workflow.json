      ]
    },
    "Synthesize \u00b7 Ollama (gemma3:1b)": {
      "ai_languageModel": [
        [
          {
            "node": "Synthesize \u00b7 LLM Chain",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Format \u00b7 Brief": {
      "main": [
        [
