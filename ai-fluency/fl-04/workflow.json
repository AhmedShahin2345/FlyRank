   },
   "credentials": {
    "ollamaApi": {
     "id": "1nNdK2Q5uooDKj93",
     "name": "Ollama Local"
    }
   }
  },
  {
   "id": "llm-1",
   "name": "Synthesize \u00b7 LLM Chain",
   "type": "@n8n/n8n-nodes-langchain.chainLlm",
   "typeVersion": 1.5,
   "position": [
    660,
    0
   ],
   "parameters": {
    "promptType": "define",
    "text": "You write a weekly industry brief on the topic \"{{ $json.topic }}\". The article below is one item from the feed. Respond with exactly three lines:\nINSIGHT: one sentence, what the reader should remember\nTAG: one of [gen-z, retail, social, data, campaigns, platform]\nRELEVANCE: one sentence, why a youth-marketing operator should care\n\nArticle:\nTitle: {{ $json.title }}\nLink: {{ $json.link }}\nDescription: {{ $json.contentSnippet }}",
    "options": {
     "systemMessage": "You write crisp industry briefs for a youth-marketing operator. Never invent facts, never ask for input, never add preamble. Output only the three labelled lines. Keep every line under 25 words."
    }
   }
  },
  {
   "id": "fmt-1",
   "name": "Format \u00b7 Brief",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    900,
    0
   ],
   "parameters": {
    "jsCode": "const items = $('Limit').all();\nconst briefs = $('Synthesize \u00b7 LLM Chain').all();\nconst topic = $('Input').first().json.topic ?? '';\nconst out = [];\nconst n = Math.min(items.length, briefs.length);\nfor (let i = 0; i < n; i++) {\n  out.push({\n    title: items[i].json.title ?? 'untitled',\n    link: items[i].json.link ?? '',\n    ai: briefs[i].json.text ?? ''\n  });\n}\nreturn [{ json: { topic, generated_at: new Date().toISOString(), count: out.length, briefs: out } }];"
   }
  }
 ],
