# Redis
REDIS_URL=redis://localhost:6379/0

# Job settings
JOB_TTL_SECONDS=86400
MAX_RETRIES=3
RETRY_BACKOFF_BASE=1.0
MAX_JOB_AGE_SECONDS=3600
DLQ_MAX_SIZE=1000

# LLM settings (inherited from BE-07)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gemma3:1b
LLM_TIMEOUT=30.0
LLM_CACHE=1
LLM_ENABLED=true

# Alerting (optional)
ALERT_WEBHOOK_URL=

# Worker
WORKER_ID=worker-1