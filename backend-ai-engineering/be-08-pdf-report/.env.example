# Redis
REDIS_URL=redis://localhost:6379/0

# PostgreSQL (from BE-04)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flyrank

# Job settings
JOB_TTL_SECONDS=86400
MAX_RETRIES=3
RETRY_BACKOFF_BASE=1.0
DLQ_MAX_SIZE=1000

# Report settings
REPORT_OUTPUT_DIR=./output/reports
REPORT_BASE_URL=http://localhost:8008/reports

# Alerting (optional)
ALERT_WEBHOOK_URL=

# Worker
WORKER_ID=report-worker-1